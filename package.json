{
  "name": "dsh-usage-stats",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "DSH 用量统计面板：token 用量、会话数、预估费用与预算、用量时间线、单会话明细，以及 CPU 活动。零依赖",
  "main": "index.js",
  "icon": "./icon.svg",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "dsh",
    "cordis",
    "plugin",
    "usage",
    "tokens",
    "cost",
    "dashboard"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "scripts": {
    "test": "node test/run-tests.mjs",
    "test:assets": "node tools/check-assets.mjs"
  }
}
